<Window x:Class="MatchScheduler.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MatchScheduler.ViewModels"
        xmlns:views="clr-namespace:MatchScheduler.Views"
        Title="Volleyball Scheduler"
        Height="780" Width="1200" MinHeight="600" MinWidth="960"
        FontFamily="Segoe UI" FontSize="14"
        Background="{StaticResource PageBrush}">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:ScheduleWizardViewModel}">
            <views:ScheduleWizardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SavedSchedulesViewModel}">
            <views:SavedSchedulesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PlayersViewModel}">
            <views:PlayersView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="#0F172A">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="22,26,22,26">
                    <TextBlock Text="🏐" FontSize="32"/>
                    <TextBlock Text="Volleyball Scheduler" Foreground="White" FontSize="17"
                               FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>

                <StackPanel Margin="10,0">
                    <Button Content="New schedule" Command="{Binding ShowWizardCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentSection}" Value="wizard">
                                        <Setter Property="Background" Value="#1E3A8A"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="Saved schedules" Command="{Binding ShowSavedCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentSection}" Value="saved">
                                        <Setter Property="Background" Value="#1E3A8A"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="Players" Command="{Binding ShowPlayersCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentSection}" Value="players">
                                        <Setter Property="Background" Value="#1E3A8A"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" Margin="28,24"/>
    </Grid>
</Window>
