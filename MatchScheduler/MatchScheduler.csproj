<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>VolleyballScheduler</AssemblyName>
    <RootNamespace>MatchScheduler</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The SQLite provider is the only package this app adds; BaseContext itself is provider-agnostic. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CathermanCore\CathermanCore.EntityFramework\CathermanCore.EntityFramework.csproj" />
    <ProjectReference Include="..\CathermanCore\CathermanCore\CathermanCore.csproj" />
  </ItemGroup>

</Project>
