<Window x:Class="MatchScheduler.Views.PlayerEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="14" Background="White"
        FocusManager.FocusedElement="{Binding ElementName=NameBox}">
    <StackPanel Margin="24">
        <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold"/>

        <TextBlock Text="Name (required)" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Text="Desired position" Style="{StaticResource FieldLabel}"/>
        <ComboBox ItemsSource="{Binding PositionOptions}"
                  DisplayMemberPath="Label" SelectedValuePath="Value"
                  SelectedValue="{Binding DesiredPosition}"/>

        <TextBlock Text="Phone number (optional)" Style="{StaticResource FieldLabel}"/>
        <TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Text="Email (optional)" Style="{StaticResource FieldLabel}"/>
        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}"
                   TextWrapping="Wrap" Margin="0,12,0,0"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" IsCancel="True"/>
            <Button Content="Save" Style="{StaticResource PrimaryButton}" IsDefault="True"
                    Click="Save_Click" Margin="0"/>
        </StackPanel>
    </StackPanel>
</Window>
