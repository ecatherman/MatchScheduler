<UserControl x:Class="MatchScheduler.Views.SavedSchedulesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Saved schedules" Style="{StaticResource PageTitle}"/>

        <TextBlock Grid.Row="1" Margin="0,16,0,0" Style="{StaticResource Muted}"
                   Text="Nothing saved yet. Build one under “New schedule” and press Save."
                   Visibility="{Binding HasNoSchedules, Converter={StaticResource BoolToVis}}"/>

        <Grid Grid.Row="1" Margin="0,16,0,0"
              Visibility="{Binding HasSchedules, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="6">
                <ListBox ItemsSource="{Binding Schedules}"
                         SelectedItem="{Binding SelectedSchedule, Mode=TwoWay}"
                         BorderThickness="0" HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="6,6">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding StartsAt, StringFormat='ddd, MMM d · h:mm tt'}"
                                           Style="{StaticResource Muted}" FontSize="12"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="{Binding SelectedSchedule.Name}" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Copy as text" Command="{Binding CopyTextCommand}"/>
                        <Button Content="Delete" Command="{Binding DeleteCommand}"/>
                        <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}"
                                   VerticalAlignment="Center" Margin="4,0,0,0"/>
                    </StackPanel>
                </StackPanel>

                <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Rounds}" ItemTemplate="{StaticResource RoundTemplate}"/>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
